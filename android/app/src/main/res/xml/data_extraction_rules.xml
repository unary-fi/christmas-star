<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: what goes into cloud backups and device-to-device transfers.
  The pairing data (this phone's owner key and its star) and the UI settings
  are kept, so a restored phone still controls its star. The developer key
  never leaves the phone; preview clips are fetched again from the star.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dev.xml" />
        <exclude domain="file" path="previews/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dev.xml" />
        <exclude domain="file" path="previews/" />
    </device-transfer>
</data-extraction-rules>
